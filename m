+#
+################################################################################
+
+SIGNAL_ESTIMATOR_VERSION = v0.0.4
+SIGNAL_ESTIMATOR_SITE = https://github.com/gavv/signal-estimator
+SIGNAL_ESTIMATOR_SITE_METHOD = git
+SIGNAL_ESTIMATOR_GIT_SUBMODULES = YES
+
