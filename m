 Ugh, that's ugly... Can't you use the convention used in shell scripts?

local name, subdir, license, rockspec
local skip = false
for i,a in ipairs(arg)
	if skip then
		skip = false
		continue
	elseif a == '--name' then
		name = arg[i + 1]
		skip = true
	elseif ...
	else
		rockspec = a
		break
	end
end


