index 3970a14db1..33444c71e0 100644
--- a/package/python-flask-babel/python-flask-babel.mk
+++ b/package/python-flask-babel/python-flask-babel.mk
@@ -8,8 +8,7 @@ PYTHON_FLASK_BABEL_VERSION = 4.0.0
