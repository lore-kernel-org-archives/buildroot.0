- libm_ARCH_OBJ:=$(patsubst $(libm_ARCH_fpu_DIR)/%.c,$(libm_ARCH_fpu_OUT)/%.o,$(libm_ARCH_SRC))
- endif
- 
-+CFLAGS-fe_nomask.c := $(CFLAGS-libm)
-+
- libm_ARCH_OBJS:=$(libm_ARCH_OBJ)
- 
- ifeq ($(DOPIC),y)
