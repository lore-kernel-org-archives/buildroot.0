>  package/mongrel2/mongrel2.mk                     |    5 ++---
>  package/python-ipy/python-ipy.mk                 |    5 ++---
>  package/sqlcipher/sqlcipher.mk                   |    4 ++--
>  6 files changed, 12 insertions(+), 14 deletions(-)
>
