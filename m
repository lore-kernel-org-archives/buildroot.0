diff --git a/linux/linux.mk b/linux/linux.mk
index 68c1121c4b..9a618db0e0 100644
--- a/linux/linux.mk
+++ b/linux/linux.mk
@@ -304,40 +304,40 @@ LINUX_NEEDS_MODULES ?= $(BR2_LINUX_NEEDS_MODULES)
 # option will be thrown away and ignored if it doesn't exist.
 ifeq ($(BR2_ENDIAN),"BIG")
