>> >    Thiago>  +define QTSERIALPORT_INSTALL_STAGING_CMDS
>> >    Thiago>  +      $(MAKE) -C $(@D)/src install
>> >    Thiago>  +      mv $(HOST_DIR)/usr/include/QtAddOnSerialPort $(STAGING_DIR)/usr/include/
