-+			status = pm_readl(POSCSR);
-+			if (status & (PM_BIT(POSCSR_LOCK0) << index))
-+				break;
-+			udelay(10);
-+		}
-+
-+		if (!(status & (PM_BIT(POSCSR_LOCK0) << index)))
-+			pr_err("clk %s: timeout waiting for lock\n",
-+					clk->name);
-+		else
-+			pr_debug("clk %s: running\n", clk->name);
-+	} else {
-+		ctrl &= ~PM_BIT(PLLx_PLLEN);
-+		pm_writel(PLL[index], ctrl);
