-+	wdt_clk_enable(wdt);
-+	spin_lock(&wdt->io_lock);
-+	ctrl = wdt_readl(wdt, CTRL);
-+	ctrl &= ctrl_mask;
-+	wdt_writel(wdt, CTRL, ctrl | WDT_BF(CTRL_KEY, 0x55));
-+	wdt_writel(wdt, CTRL, ctrl | WDT_BF(CTRL_KEY, 0xaa));
