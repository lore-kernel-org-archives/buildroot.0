-+	mpop_writel(sinfo, ATMEL_MPOP_CURSOR_SIZE,
-+			(sinfo->overlay_info[ATMEL_MPOPFB_CURSOR].xsize << ATMEL_MPOP_CURSOR_SIZE_CURSOR_SIZE_X)
