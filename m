-+	if (apply) {
-+		if (actual != rate)
-+			return -EINVAL;
-+		if (clk->users > 0)
-+			return -EBUSY;
-+		pr_debug(KERN_INFO "clk %s: new rate %lu (actual rate %lu)\n",
-+				clk->name, rate, actual);
-+		pm_writel(PLL[clk->index], ctrl);
-+	}
-+
-+	return actual;
