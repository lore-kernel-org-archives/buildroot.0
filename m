index 3543008..13616d5 100644
--- a/linux/Config.in
+++ b/linux/Config.in
@@ -120,7 +120,7 @@ endif
 
 config BR2_LINUX_KERNEL_VERSION
 	string
-	default "4.18.3" if BR2_LINUX_KERNEL_LATEST_VERSION
