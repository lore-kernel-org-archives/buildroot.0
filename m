 board/zynqmp/kria/kv260/pm_cfg_obj.c   | 556 +++++++++++++++++++++++++
 board/zynqmp/kria/kv260/uboot.fragment |   1 +
 board/zynqmp/kria/post-build.sh        |   8 +
 board/zynqmp/kria/readme.txt           |  78 ++++
