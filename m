+		$(call KCONFIG_ENABLE_OPT,CONFIG_SECURITY_APPARMOR)
+		$(call KCONFIG_ENABLE_OPT,CONFIG_DEFAULT_SECURITY_APPARMOR))
 	$(if $(BR2_PACKAGE_LIBSELINUX),
