-+    unwindcache.table.free = NULL;
-+    unwindcache.table.size = 0;
-+    __mp_newtree(&unwindcache.itree);
-+    __mp_newtree(&unwindcache.dtree);
-+    unwindcache.size = 0;
-+    unwindcache.init = 0;
-+}
