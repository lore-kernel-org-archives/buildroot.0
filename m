-         uint16_t dst_port) {
--
-+#ifndef NO_IPV6
-     struct sockaddr_in6 sa;
-     struct msghdr msg;
-     struct iovec io;
-@@ -620,6 +634,9 @@ int avahi_send_dns_packet_ipv6(
-     }
- 
-     return sendmsg_loop(fd, &msg, 0);
-+#else
-+    return -1;
-+#endif
- }
