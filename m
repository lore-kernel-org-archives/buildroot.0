-+static irqreturn_t rtc_ast_interrupt(int irq, void *dev_id)
-+{
-+	struct rtc_ast	*ast = dev_id;
-+	unsigned long	events;
-+	unsigned long	num;
-+	u32		status;
-+	u32		pending;
