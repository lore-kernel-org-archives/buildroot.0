-+	/* Use YCbCr --> RGB converion per default. */
-+	memcpy(&sinfo->rgbconv_coeffs, &atmel_mpop_ycrcb2rgb_coeffs,
-+	       sizeof(struct atmel_mpopfb_rgbconv_coeffs));
