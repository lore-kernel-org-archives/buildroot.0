+CONFIG_SATA_AHCI_PLATFORM=y
 CONFIG_NETDEVICES=y
 CONFIG_VIRTIO_NET=y
-# CONFIG_ETHERNET is not set
-# CONFIG_WLAN is not set
+CONFIG_MACB=y
+CONFIG_E1000E=y
+CONFIG_R8169=y
