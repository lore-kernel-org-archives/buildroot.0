-+	return 0;
-+
-+free_cmap:
-+	fb_dealloc_cmap(&info->cmap);
-+unregister_irqs:
-+	free_irq(sinfo->irq_base, info);
-+release_mem_slave:
-+	release_mem_region(slave->start, slave->end - slave->start + 1);
-+unmap_mmio:
-+	iounmap(sinfo->mmio);
