-PYTHON_FLASK_BABEL_SETUP_TYPE = pep517
+PYTHON_FLASK_BABEL_SETUP_TYPE = poetry
 PYTHON_FLASK_BABEL_LICENSE_FILES = LICENSE
-PYTHON_FLASK_BABEL_DEPENDENCIES = host-python-poetry-core
 
 $(eval $(python-package))
