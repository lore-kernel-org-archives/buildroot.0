 board/olpc/linux.config  | 461 +++++++++++++++++++++++++++++++++++++++
 board/olpc/olpc.fth      |  37 ++++
 board/olpc/post-build.sh |  18 ++
 board/olpc/post-image.sh |  16 ++
 5 files changed, 542 insertions(+)
 create mode 100644 board/olpc/genimage.cfg
 create mode 100644 board/olpc/linux.config
 create mode 100644 board/olpc/olpc.fth
