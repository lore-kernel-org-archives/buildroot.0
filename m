+CONFIG_USB_OHCI_HCD=y
+CONFIG_USB_OHCI_HCD_PLATFORM=y
+CONFIG_USB_STORAGE=y
+CONFIG_USB_UAS=y
 CONFIG_VIRTIO_MMIO=y
-CONFIG_EXT2_FS=y
+CONFIG_SIFIVE_PLIC=y
