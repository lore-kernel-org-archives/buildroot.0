-+	ctrl |= PM_BF(PLLx_PLLCOUNT, 31);
-+	ctrl |= PM_BF(PLLx_PLLMUL, mul_best_fit);
-+	ctrl |= PM_BF(PLLx_PLLDIV, div_best_fit);
-+	ctrl |= PM_BF(PLLx_PLLOSC, clk->parent->index);
