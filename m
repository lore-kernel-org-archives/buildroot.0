-+	case 3:
-+		ctrl_mask |= (1 << WDT_CTRL_CEN) | (1 << WDT_CTRL_CSEL);
-+		/* fall through */
-+	case 2:
-+		ctrl_mask |= 0x1f << WDT_CTRL_PSEL;
-+		break;
-+	case 1:
-+		ctrl_mask |= 0x0f << WDT_CTRL_PSEL;
-+		break;
-+	}
