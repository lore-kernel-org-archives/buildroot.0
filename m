-+
-+	oprofile_add_trace(bufhead[0].lr);
-+
-+	/* frame pointers should strictly progress back up the stack
-+	 * (towards higher addresses) */
-+	if (bufhead[0].fp <= head)
-+		return NULL;
-+
-+	return bufhead[0].fp;
-+}
-+
-+void avr32_backtrace(struct pt_regs * const regs, unsigned int depth)
-+{
