 > +++ b/configs/mx53loco_defconfig
 > @@ -1,22 +1,16 @@
 > -# Architecture
 >  BR2_arm=y
 >  BR2_cortex_a8=y
 > -BR2_ARM_FPU_VFPV3D16=y
 > -
