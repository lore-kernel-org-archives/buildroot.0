diff --git a/DEVELOPERS b/DEVELOPERS
index b35f543d00..7cf0630fb8 100644
--- a/DEVELOPERS
+++ b/DEVELOPERS
@@ -1544,6 +1544,7 @@ F:	package/fswebcam/
 
