         print("CPE: Fetching xml manifest...")
@@ -23,9 +85,9 @@ class CPEDB:
 
             for cpe in self.all_cpedb['cpe-list']['cpe-item']:
                 cpe_str = cpe['cpe-23:cpe23-item']['@name']
