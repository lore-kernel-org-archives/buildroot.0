-+#define TIMEOUT_MIN		1
-+#ifdef CONFIG_CPU_AT32AP700X
-+# define TIMEOUT_MAX		2
-+# define TIMEOUT_DEFAULT	TIMEOUT_MAX
-+#else
-+# define TIMEOUT_MAX		131072
-+# define TIMEOUT_DEFAULT	64
-+#endif
-+
-+/* module parameters */
-+static int timeout =  TIMEOUT_DEFAULT;
