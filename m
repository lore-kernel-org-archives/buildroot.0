 board/synopsys/vdk/linux-vdk-defconfig    | 817 ++++++++++++++++++++++++++++++
 configs/snps_vdk_defconfig                |  16 +
 3 files changed, 869 insertions(+)
 create mode 100644 board/synopsys/vdk/fs-overlay/etc/inittab
 create mode 100644 board/synopsys/vdk/linux-vdk-defconfig
