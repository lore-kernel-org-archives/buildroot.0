 package/hawktracer/Config.in       | 25 ----------------
 package/hawktracer/hawktracer.hash |  3 --
 package/hawktracer/hawktracer.mk   | 48 ------------------------------
 6 files changed, 6 insertions(+), 78 deletions(-)
 delete mode 100644 package/hawktracer/Config.in
